# 后端环境变量模板（复制为 backend/.env 使用）
# 数据库连接（默认本地 SQLite）
DATABASE_URL=sqlite+aiosqlite:///./devflow.db
# 允许的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:3000"]
# WebSocket 心跳间隔（秒）
WS_HEARTBEAT_INTERVAL=30
# 健康检查轮询间隔（秒）
MONITOR_INTERVAL=10

# 前端环境变量（frontend/.env.local）
# NEXT_PUBLIC_API_URL=http://localhost:8000
